PORT=3000
NODE_ENV=production
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
# Comma-separated list of allowed browser origins
CORS_ORIGINS=https://warehouse.example.com

# "postgres" (recommended for production) or "sqlite" (zero-dependency local dev)
DB_TYPE=postgres
SQLITE_PATH=warehouse.sqlite
DB_SYNCHRONIZE=false

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=warehouse
DB_PASSWORD=warehouse
DB_NAME=warehouse_db
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Persistent directory for product images (served publicly at /uploads).
# Point this at a path that survives redeploys, e.g. /var/lib/warehouse/uploads.
UPLOAD_DIR=/var/lib/warehouse/uploads
